{
  "name": "graphrag",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @graphrag/web dev",
    "build": "bun run --filter @graphrag/web build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "test:e2e": "bun run --filter @graphrag/web test:e2e",
    "eval": "bun run packages/retrieval/eval/run.ts",
    "eval:answers": "bun run packages/retrieval/eval/run.ts --answers",
    "content:check": "bun run packages/graph-index/src/cli.ts check",
    "content:index": "oxfmt content && bun run packages/graph-index/src/cli.ts index",
    "content:ask": "bun run packages/graph-index/src/cli.ts ask",
    "content:new": "bun run packages/graph-index/src/cli.ts new",
    "content:render": "bun run apps/web/scripts/render.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@effect/language-service": "^0.87.2",
    "@types/bun": "^1.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-plugin-eslint": "1.83.0",
    "temporal-polyfill": "^1.0.5",
    "typescript": "^6.0.0"
  },
  "lint-staged": {
    "*.{ts,js,svelte}": [
      "oxlint",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "content/**/*.md": [
      "bun content:check"
    ]
  },
  "packageManager": "bun@1.4.0"
}
